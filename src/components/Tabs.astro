---
// 使い方:
// <Tabs>
//   <Tab label="2025/10/23 v1">...</Tab>
//   <Tab label="2026/04/16 v2" active>...</Tab>
// </Tabs>
---

<div class="tabs-wrapper">
  <div class="tab-labels"></div>
  <div class="tab-content">
    <slot />
  </div>
  <div class="tab-labels tab-labels-bottom"></div>
</div>

<script>
  const TAB_W = 200;
  const TAB_H = 36;
  const TAB_SKEW = 12;
  const TAB_SW = 1.5;
  const TAB_FONT_SIZE = 14;
  // 台形内の使用可能テキスト幅（両端のskew + 余白を除く）
  const TAB_TEXT_MAX_W = TAB_W - TAB_SKEW * 1.2 - 16;

  // タブ列の移動アニメーション（減速しながら止まる）
  const SLIDE_TRANSITION = 'transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1)';

  // .tab-labels-inner の現在の横位置（左へ動かした量）。transition中は途中の値が返る
  function readOffset(inner: HTMLElement | null): number {
    if (!inner) return 0;
    return -new DOMMatrixReadOnly(getComputedStyle(inner).transform).m41;
  }

  function setOffset(inner: HTMLElement, offset: number) {
    inner.style.transform = `translateX(${-offset}px)`;
  }

  // fromOffset: 作り直す前のタブ列の位置。そこから中央寄せ位置まで動かす
  function centerActiveTab(inner: HTMLElement, idx: number, animate: boolean = true, fromOffset: number = 0) {
    const btn = inner.children[idx] as HTMLElement | null;
    if (!btn) return;
    const containerWidth = inner.parentElement?.offsetWidth ?? 0;
    const totalWidth = inner.scrollWidth;
    const target = btn.offsetLeft + btn.offsetWidth / 2 - containerWidth / 2;
    const clamped = Math.min(Math.max(0, target), Math.max(0, totalWidth - containerWidth));
    if (animate) {
      inner.style.transition = 'none';
      setOffset(inner, fromOffset);
      inner.getBoundingClientRect(); // 開始位置を確定させてからtransitionを掛ける
    }
    inner.style.transition = animate ? SLIDE_TRANSITION : 'none';
    setOffset(inner, clamped);
  }

  function fitTextToTab(svgEl: SVGSVGElement) {
    const textEl = svgEl.querySelector<SVGTextElement>('text');
    if (!textEl) return;
    const measured = textEl.getComputedTextLength();
    if (measured > TAB_TEXT_MAX_W) {
      const scaled = Math.floor(TAB_FONT_SIZE * TAB_TEXT_MAX_W / measured);
      textEl.setAttribute('font-size', String(scaled));
    }
  }

  function buildTabSVG(label: string, active: boolean): SVGSVGElement {
    const W = TAB_W;
    const H = TAB_H;
    const SKEW = TAB_SKEW;
    const SW = TAB_SW;

    const vw = W;
    const vh = H + SW;

    const pts = `0,${vh} ${SKEW * 0.6},1.5 ${vw - SKEW * 0.6},1.5 ${vw},${vh}`;

    const STROKE = '#999592';
    const BG_ACTIVE = getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim() || '#ffffff';
    const BG_INACTIVE = '#dedad0';
    const TEXT_ACTIVE = '#111111';
    const TEXT_INACTIVE = '#aaaaaa';

    const bg = active ? BG_ACTIVE : BG_INACTIVE;
    const textColor = active ? TEXT_ACTIVE : TEXT_INACTIVE;
    const bottomStroke = active ? BG_ACTIVE : STROKE;
    const bottomSW = active ? SW + 1 : SW;

    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('width', String(vw));
    svg.setAttribute('height', String(vh));
    svg.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
    svg.style.cssText = 'display:block;overflow:visible';

    const poly = document.createElementNS(ns, 'polygon');
    poly.setAttribute('points', pts);
    poly.setAttribute('fill', bg);
    svg.appendChild(poly);

    const path = document.createElementNS(ns, 'path');
    path.setAttribute('d', `M 0 ${vh} L ${SKEW * 0.6} 1.5 L ${vw - SKEW * 0.6} 1.5 L ${vw} ${vh}`);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', STROKE);
    path.setAttribute('stroke-width', String(SW));
    path.setAttribute('stroke-linejoin', 'round');
    path.setAttribute('stroke-linecap', 'round');
    svg.appendChild(path);

    const line = document.createElementNS(ns, 'line');
    line.setAttribute('x1', '0');
    line.setAttribute('y1', String(vh - SW / 4));
    line.setAttribute('x2', String(vw));
    line.setAttribute('y2', String(vh - SW / 4));
    line.setAttribute('stroke', bottomStroke);
    line.setAttribute('stroke-width', String(bottomSW));
    svg.appendChild(line);

    const text = document.createElementNS(ns, 'text');
    text.setAttribute('x', String(vw / 2));
    text.setAttribute('y', String(H / 2 + 5));
    text.setAttribute('text-anchor', 'middle');
    text.setAttribute('font-family', "'IBM Plex Mono', monospace");
    text.setAttribute('font-size', String(TAB_FONT_SIZE));
    text.setAttribute('font-weight', active ? '700' : '500');
    text.setAttribute('letter-spacing', '0.12em');
    text.setAttribute('fill', textColor);
    text.style.userSelect = 'none';
    text.textContent = label;
    svg.appendChild(text);

    return svg;
  }

  function buildTabSVGBottom(label: string, active: boolean): SVGSVGElement {
    const W = TAB_W;
    const H = TAB_H;
    const SKEW = TAB_SKEW;
    const SW = TAB_SW;
    const vw = W;
    const vh = H + SW;

    const pts = `0,0 ${SKEW * 0.6},${vh - 1.5} ${vw - SKEW * 0.6},${vh - 1.5} ${vw},0`;

    const STROKE = '#999592';
    const BG_ACTIVE = getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim() || '#ffffff';
    const BG_INACTIVE = '#dedad0';
    const TEXT_ACTIVE = '#111111';
    const TEXT_INACTIVE = '#aaaaaa';

    const bg = active ? BG_ACTIVE : BG_INACTIVE;
    const textColor = active ? TEXT_ACTIVE : TEXT_INACTIVE;
    const topStroke = active ? BG_ACTIVE : STROKE;
    const topSW = active ? SW + 1 : SW;

    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('width', String(vw));
    svg.setAttribute('height', String(vh));
    svg.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
    svg.style.cssText = 'display:block;overflow:visible';

    const poly = document.createElementNS(ns, 'polygon');
    poly.setAttribute('points', pts);
    poly.setAttribute('fill', bg);
    svg.appendChild(poly);

    const path = document.createElementNS(ns, 'path');
    path.setAttribute('d', `M 0 0 L ${SKEW * 0.6} ${vh - 1.5} L ${vw - SKEW * 0.6} ${vh - 1.5} L ${vw} 0`);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', STROKE);
    path.setAttribute('stroke-width', String(SW));
    path.setAttribute('stroke-linejoin', 'round');
    path.setAttribute('stroke-linecap', 'round');
    svg.appendChild(path);

    const line = document.createElementNS(ns, 'line');
    line.setAttribute('x1', '0');
    line.setAttribute('y1', String(SW / 4));
    line.setAttribute('x2', String(vw));
    line.setAttribute('y2', String(SW / 4));
    line.setAttribute('stroke', topStroke);
    line.setAttribute('stroke-width', String(topSW));
    svg.appendChild(line);

    const text = document.createElementNS(ns, 'text');
    text.setAttribute('x', String(vw / 2));
    text.setAttribute('y', String(H / 2 + 5));
    text.setAttribute('text-anchor', 'middle');
    text.setAttribute('font-family', "'IBM Plex Mono', monospace");
    text.setAttribute('font-size', String(TAB_FONT_SIZE));
    text.setAttribute('font-weight', active ? '700' : '500');
    text.setAttribute('letter-spacing', '0.12em');
    text.setAttribute('fill', textColor);
    text.style.userSelect = 'none';
    text.textContent = label;
    svg.appendChild(text);

    return svg;
  }

  // タブ列をドラッグ（PC）・スワイプ（スマホ）で横に動かす。はみ出していない場合は動かさない
  // activate()でタブ列の中身（.tab-labels-inner）は作り直されるため、毎回containerから取り直す
  // 戻り値: 慣性移動を止める関数（タブ切り替え時に呼ぶ）
  function enableDrag(container: HTMLElement): () => void {
    const DRAG_THRESHOLD = 5;   // これ未満の移動はクリックとして扱う
    const FRICTION = 0.95;      // 慣性の減衰率（16msあたり）
    const EDGE_FRICTION = 0.6;  // 端を越えた後の減衰率（16msあたり）
    const MAX_VELOCITY = 4;     // px/ms
    const VELOCITY_WINDOW = 100; // 指を離す直前この時間(ms)の動きから速度を求める

    let pointerId: number | null = null;
    let startX = 0;
    let startOffset = 0;
    let offset = 0;             // 端の抵抗をかける前の位置
    let moved = false;
    let samples: { t: number; x: number }[] = [];
    let rafId = 0;

    const getInner = () => container.querySelector<HTMLElement>('.tab-labels-inner');
    const maxOffset = (inner: HTMLElement) => Math.max(0, inner.scrollWidth - container.offsetWidth);

    // 端を越えた分はゴムのように引っ張り量を弱めて表示する
    const rubber = (o: number, max: number) => {
      const w = container.offsetWidth || 1;
      const damp = (d: number) => (1 - 1 / (d * 0.55 / w + 1)) * w;
      if (o < 0) return -damp(-o);
      if (o > max) return max + damp(o - max);
      return o;
    };

    const stop = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const settle = (inner: HTMLElement) => {
      const max = maxOffset(inner);
      if (offset < 0 || offset > max) {
        offset = Math.min(Math.max(0, offset), max);
        inner.style.transition = SLIDE_TRANSITION;
        setOffset(inner, offset);
      }
    };

    const startInertia = (velocity: number) => {
      let v = velocity;
      let last = performance.now();
      const step = (now: number) => {
        const inner = getInner();
        if (!inner) return stop();
        const dt = Math.min(now - last, 50);
        last = now;
        const max = maxOffset(inner);
        const outside = offset < 0 || offset > max;
        v *= Math.pow(outside ? EDGE_FRICTION : FRICTION, dt / 16);
        offset += v * dt;
        inner.style.transition = 'none';
        setOffset(inner, rubber(offset, max));
        if (Math.abs(v) < 0.02) {
          rafId = 0;
          settle(inner);
          return;
        }
        rafId = requestAnimationFrame(step);
      };
      rafId = requestAnimationFrame(step);
    };

    container.addEventListener('pointerdown', e => {
      const inner = getInner();
      if (!inner || maxOffset(inner) <= 0) return;
      stop();
      // 慣性・transitionの途中でも、触れた位置でそのまま止める
      offset = readOffset(inner);
      inner.style.transition = 'none';
      setOffset(inner, offset);
      pointerId = e.pointerId;
      startX = e.clientX;
      moved = false;
      samples = [];
    });

    container.addEventListener('pointermove', e => {
      if (e.pointerId !== pointerId) return;
      if (!moved) {
        if (Math.abs(e.clientX - startX) < DRAG_THRESHOLD) return;
        moved = true;
        container.setPointerCapture(e.pointerId);
        // しきい値ぶん跳ばないよう、動き出した地点を起点にする
        startX = e.clientX;
        startOffset = offset;
      }
      const inner = getInner();
      if (!inner) return;
      const now = performance.now();
      samples.push({ t: now, x: e.clientX });
      while (samples.length > 2 && now - samples[0].t > VELOCITY_WINDOW) samples.shift();
      offset = startOffset - (e.clientX - startX);
      setOffset(inner, rubber(offset, maxOffset(inner)));
    });

    const end = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      if (!moved) return;
      const inner = getInner();
      if (!inner) return;
      const now = performance.now();
      const first = samples[0];
      const last = samples[samples.length - 1];
      let v = 0;
      // 指を止めてから離した場合は慣性を付けない
      if (first && last && last.t > first.t && now - last.t < 50) {
        v = -(last.x - first.x) / (last.t - first.t);
        v = Math.max(-MAX_VELOCITY, Math.min(MAX_VELOCITY, v));
      }
      if (Math.abs(v) > 0.1) startInertia(v);
      else settle(inner);
    };
    container.addEventListener('pointerup', end);
    container.addEventListener('pointercancel', end);

    // ドラッグ直後のクリックでタブが切り替わらないようにする
    container.addEventListener('click', e => {
      if (!moved) return;
      moved = false;
      e.stopPropagation();
      e.preventDefault();
    }, true);

    return stop;
  }

  document.querySelectorAll<HTMLElement>('.tabs-wrapper').forEach(wrapper => {
    const panels = Array.from(wrapper.querySelectorAll<HTMLElement>('.tab-panel'));
    const labelsEl = wrapper.querySelector<HTMLElement>('.tab-labels')!;
    const labelsBottomEl = wrapper.querySelector<HTMLElement>('.tab-labels-bottom')!;

    if (panels.length < 2) labelsBottomEl.style.display = 'none';

    let activeIdx = panels.findIndex(p => p.dataset.active === 'true');
    if (activeIdx < 0) activeIdx = 0;

    const stopDrags: (() => void)[] = [];

    function activate(idx: number, animate: boolean = true) {
      panels.forEach(p => p.classList.remove('is-active'));
      panels[idx].classList.add('is-active');

      // 作り直す前の位置を控えて、そこから中央寄せ位置へ動かす
      stopDrags.forEach(stop => stop());
      const prevOffset = readOffset(labelsEl.querySelector<HTMLElement>('.tab-labels-inner'));
      const prevOffsetB = readOffset(labelsBottomEl.querySelector<HTMLElement>('.tab-labels-inner'));

      labelsEl.innerHTML = '';
      labelsBottomEl.innerHTML = '';

      const inner = document.createElement('div');
      inner.className = 'tab-labels-inner';
      labelsEl.appendChild(inner);

      const innerB = document.createElement('div');
      innerB.className = 'tab-labels-inner';
      labelsBottomEl.appendChild(innerB);

      panels.forEach((panel, i) => {
        const label = panel.dataset.label ?? '';
        const isActive = i === idx;

        const btn = document.createElement('button');
        btn.className = 'tab-btn' + (isActive ? ' is-active' : '');
        btn.setAttribute('aria-selected', String(isActive));
        btn.appendChild(buildTabSVG(label, isActive));
        btn.addEventListener('click', () => activate(i));
        inner.appendChild(btn);
        fitTextToTab(btn.querySelector('svg')!);

        const btnB = document.createElement('button');
        btnB.className = 'tab-btn tab-btn-bottom' + (isActive ? ' is-active' : '');
        btnB.setAttribute('aria-selected', String(isActive));
        btnB.appendChild(buildTabSVGBottom(label, isActive));
        btnB.addEventListener('click', () => {
          activate(i);
          const top = wrapper.getBoundingClientRect().top + window.scrollY;
          const headerH = (document.querySelector('header') as HTMLElement | null)?.offsetHeight ?? 0;
          window.scrollTo({ top: top - headerH - 8, behavior: 'smooth' });
        });
        innerB.appendChild(btnB);
        fitTextToTab(btnB.querySelector('svg')!);
      });

      centerActiveTab(inner, idx, animate, prevOffset);
      centerActiveTab(innerB, idx, animate, prevOffsetB);
    }

    activate(activeIdx, false);
    stopDrags.push(enableDrag(labelsEl), enableDrag(labelsBottomEl));

    // URLの #tab2 のような指定で該当タブ（1始まり）を開き、タブ位置までスクロール
    function openFromHash(animate: boolean) {
      const m = location.hash.match(/^#tab(\d+)$/);
      if (!m) return;
      const idx = Number(m[1]) - 1;
      if (idx < 0 || idx >= panels.length) return;
      activate(idx, animate);
      const top = wrapper.getBoundingClientRect().top + window.scrollY;
      const headerH = (document.querySelector('header') as HTMLElement | null)?.offsetHeight ?? 0;
      window.scrollTo({ top: top - headerH - 8, behavior: animate ? 'smooth' : 'auto' });
    }
    openFromHash(false);
    window.addEventListener('hashchange', () => openFromHash(true));
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap');

  .tabs-wrapper {
    margin: 2rem 0;
  }

  .tab-labels {
    overflow-x: clip;
    touch-action: pan-y; /* 横スワイプはタブ列のドラッグに使い、縦スクロールはブラウザに任せる */
    user-select: none;
    -webkit-user-select: none;
  }

  .tab-labels:not(.tab-labels-bottom) {
    position: relative;
    z-index: 1;
    margin-bottom: -1.5px;
  }

  :global(.tab-labels-inner) {
    display: flex;
    align-items: flex-end;
    gap: 0;
    will-change: transform;
  }

  :global(.tab-btn) {
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: none;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    margin-right: -1.5px;
    position: relative;
    display: block;
    outline: none;
    line-height: 0;
    overflow: visible;
  }
  :global(.tab-btn.is-active) {
    z-index: 2;
  }

  .tab-content {
    border-top: 1.5px solid #999592;
    border-bottom: 1.5px solid #999592;
    padding: 28px 4px;
    font-size: 17px;
    line-height: 1.85;
    position: relative;
    z-index: 0;
  }
  @media (max-width: 800px) {
    .tab-content { font-size: 16px; }
  }

  .tab-labels-bottom {
    align-items: flex-start;
  }

  :global(.tab-btn-bottom.is-active::after) {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--color-bg);
    z-index: 3;
  }

  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; }
</style>
