---
interface Props {
  title?: string;
}
const { title = "" } = Astro.props;
---

<div class="memo">
  {title && <p class="memo-title">{title}</p>}
  <div class="memo-body"><slot /></div>
</div>
<br />
<hr />
<br />

<style>
.memo {
  margin: 1.75rem 0;
  color: var(--color-text);
}

.memo-title {
  margin: 0 0 1rem;
  font-size: 1.3em;
  font-weight: 800;
  color: var(--color-text);
}

/* Dynalist風：項目内の行は詰め、項目の間で区切る。点はグレーで控えめにし、子のかたまりには縦のガイド線
   .work-body側のリスト余白（WorkLayout.astro）と詳細度が同じだと読み込み順で負けて
   階層ごとに余白がずれるため、.memo .memo-body で詳細度を上げている */
.memo .memo-body :global(ul) {
  margin: 0;
  padding-left: 1.3em;
  list-style: none;
}

.memo .memo-body :global(li) {
  position: relative;
  margin: 0.4em 0;
  line-height: 1.6;
}

.memo .memo-body :global(li > ul) {
  position: relative;
  margin: 0.4em 0 0;
}

/* 子のかたまりの左に、親の点の中心から下ろす縦線 */
.memo .memo-body :global(li > ul::before) {
  content: '';
  position: absolute;
  left: calc(-1.1em + 3px);
  top: 0;
  bottom: 0.2em;
  width: 1px;
  background: var(--color-border);
}

/* 項目間に空行を入れると、Markdownが本文を<p>で包み .work-body の段落余白が付くため打ち消す */
.memo .memo-body :global(li > p) {
  margin: 0;
}
.memo .memo-body :global(li > p + p) {
  margin-top: 0.4em;
}

/* 点：1行目の中央（line-height 1.6 → 0.8em）に合わせ、階層が深いほど小さく */
.memo-body :global(li::before) {
  --dot: 7px;
  content: '';
  position: absolute;
  left: -1.1em;
  top: calc(0.8em - var(--dot) / 2);
  width: var(--dot);
  height: var(--dot);
  border-radius: 50%;
  background: var(--color-text-muted);
}

/* アウトライン記事：<Band>を置いた項目は点・縦線を消し、帯をMemoの左端に揃える
   （.work-body側の同等の指定はMemoの詳細度に負けるため、Memo側で持つ） */
.memo .memo-body :global(li:has(> .band)) {
  margin-left: -1.3em;
}
.memo .memo-body :global(li:has(> .band):not(:first-child)) {
  margin-top: 1.5rem;
}
.memo-body :global(li:has(> .band)::before),
.memo .memo-body :global(li:has(> .band) > ul::before) {
  display: none;
}

.memo-body :global(ul ul li::before) {
  --dot: 5px;
  left: calc(-1.1em + 1px);
}

.memo-body :global(ul ul ul li::before) {
  --dot: 4px;
  left: calc(-1.1em + 1.5px);
}
</style>
