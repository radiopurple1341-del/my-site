---
import { SITE_TITLE, NOTE_URL, TWITTER_HANDLE } from '../consts';
---

<footer>
  <div class="site-wrap footer-inner">
    <span class="footer-title">{SITE_TITLE}</span>
    <div class="footer-links">
      <a href={NOTE_URL} target="_blank" rel="noopener">note</a>
      <a href={`https://twitter.com/${TWITTER_HANDLE.replace('@','')}`} target="_blank" rel="noopener">X / Twitter</a>
      <a href="/about">about</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
footer {
  margin-top: auto;
  border-top: 0.5px solid var(--color-border);
  padding: 1.5rem 0;
}
.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-title {
  font-size: 12px;
  color: var(--color-text-muted);
}
.footer-links {
  display: flex;
  gap: 1rem;
}
.footer-links a {
  font-size: 12px;
  color: var(--color-text-muted);
}
.footer-links a:hover {
  color: var(--color-text);
}
</style>
