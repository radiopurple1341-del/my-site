---
interface Props {
  url: string;
}

const { url } = Astro.props;

// URLからIDを抽出（通常URL・短縮URL・embed URL に対応）
const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
const id = match?.[1] ?? '';
---

{id
  ? (
    <div class="yt-wrap">
      <iframe
        src={`https://www.youtube.com/embed/${id}`}
        title="YouTube video"
        frameborder="0"
        allowfullscreen
      />
    </div>
  )
  : <p class="yt-error">YouTube URLが正しくありません: {url}</p>
}

<style>
.yt-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  margin: 1.5rem 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #000;
}
.yt-wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.yt-error {
  font-size: 12px;
  color: var(--color-text-muted);
}
</style>
