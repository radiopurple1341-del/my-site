---
interface Props {
  label?: string;
}
const { label = '続きを読む ' } = Astro.props;
---

<details class="expand">
  <summary class="expand-btn">
    <span class="label-closed">{label}</span>
    <span class="label-open">--------</span>
  </summary>
  <div class="expand-body">
    <slot />
  </div>
</details>

<style>
.expand { margin: 1.25rem 0; }
.expand-btn {
  display: inline;
  font-size: 20px;
  font-weight: 800;
  color: #0033cc;
  cursor: pointer;
  list-style: none;
  user-select: none;
  text-decoration: none;
}
.expand-btn::-webkit-details-marker { display: none; }
.expand-btn::before {
  content: '▶▶\00a0';
  font-size: 20px;
  display: inline-block;
  transition: transform 0.2s;
}
details[open] > summary.expand-btn::before {
  transform: rotate(90deg);
}

.label-open { display: none; }
details[open] > summary .label-closed { display: none; }
details[open] > summary .label-open { display: inline; }
.expand-body {
  margin-top: 1rem;
}
</style>
