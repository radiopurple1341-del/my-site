---
interface Props {
  rating: number;
}

const { rating } = Astro.props;
const scoreColor = rating >= 90 ? '#0033cc' : rating >= 80 ? '#c41a1a' : 'var(--color-text)';
---

<div class="review">
  <div class="review-header">
    <span class="review-label">Review</span>
    <span class="review-right">
      <span class="review-score" style={`color: ${scoreColor}`}>{rating}</span>
      <span class="review-unit">/ 100</span>
    </span>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500;700&display=swap');

  .review {
    background: var(--color-bg);
    color: #000;
    padding: 0;
    margin: 2.5rem 0;
    border-top: 2.5px solid var(--color-text);
    border-bottom: 2.5px solid var(--color-text);
    border-left: 1px solid #111;
    border-right: 1px solid #111;
    font-family: var(--font-sans, 'IBM Plex Sans JP', sans-serif);
  }

  .review-header {
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 10px;
    margin-bottom: 0px;
  }

  .review-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000;
  }

  .review-right {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
  }

  .review-score {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 88px;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .review-unit {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 15px;
    font-weight: 500;
    color: #222;
    margin-left: 4px;
  }

  .review-body {
    font-size: 14px;
    line-height: 1.85;
    color: #222;
    text-wrap: pretty;
  }

  .review-footer:empty {
    display: none;
  }

  .review-footer {
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px solid #ccc;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: #999;
    letter-spacing: 0.12em;
  }

  :global(.dark) .review {
    background: var(--color-bg);
    color: #e8e4dc;
  }
  :global(.dark) .review-header {
    border-top-color: #e8e4dc;
    border-bottom-color: #e8e4dc;
  }
  :global(.dark) .review-label { color: #999; }
  :global(.dark) .review-body { color: #c8c4bc; }
  :global(.dark) .review-footer {
    border-top-color: #333;
    color: #666;
  }

  @media (prefers-color-scheme: dark) {
    .review {
      background: var(--color-bg);
      color: #e8e4dc;
    }
    .review-header {
      border-top-color: #e8e4dc;
      border-bottom-color: #e8e4dc;
    }
    .review-label { color: #222; }
    .review-body { color: #c8c4bc; }
    .review-footer {
      border-top-color: #333;
      color: #666;
    }
  }
</style>
