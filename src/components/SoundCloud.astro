---
interface Props {
  url: string; // 曲ページURL（https://soundcloud.com/...）または埋め込みコードの src（https://w.soundcloud.com/player/?url=...）
}

const { url } = Astro.props;

// 埋め込みコードの src はそのまま使い、曲ページURLならプレーヤーURLを組み立てる
const isPlayerUrl = /^https:\/\/w\.soundcloud\.com\/player\//.test(url);
const isTrackUrl  = /^https:\/\/(?:www\.|m\.)?soundcloud\.com\//.test(url);
const embedUrl = isPlayerUrl
  ? url
  : `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true`;
const height = 166;
---

{isPlayerUrl || isTrackUrl
  ? (
    <div class="soundcloud-wrap" style={`height: ${height}px`}>
      <iframe
        src={embedUrl}
        height={height}
        scrolling="no"
        frameborder="no"
        allow="autoplay; encrypted-media"
        loading="lazy"
      />
    </div>
  )
  : <p class="soundcloud-error">SoundCloud URLが正しくありません: {url}</p>
}

<style>
.soundcloud-wrap {
  width: 100%;
  margin: 1.5rem 0;
}
.soundcloud-wrap iframe {
  width: 100%;
  height: 100%;
}
.soundcloud-error {
  font-size: 12px;
  color: var(--color-text-muted);
}
</style>
