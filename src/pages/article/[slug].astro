---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import WorkLayout from '../../layouts/WorkLayout.astro';
// MDX本文で使うコンポーネント。ここに登録すれば各記事でimportしなくても使える
import B from '../../components/B.astro';
import R from '../../components/R.astro';
import RB from '../../components/RB.astro';
import U from '../../components/U.astro';
import URL from '../../components/URL.astro';
import Band from '../../components/Band.astro';
import Expand from '../../components/Expand.astro';
import LinkCard from '../../components/LinkCard.astro';
import Memo from '../../components/Memo.astro';
import Quote from '../../components/Quote.astro';
import Review from '../../components/Review.astro';
import Spotify from '../../components/Spotify.astro';
import SoundCloud from '../../components/SoundCloud.astro';
import YouTube from '../../components/YouTube.astro';
import Tabs from '../../components/Tabs.astro';
import Tab from '../../components/Tab.astro';
import Tracklist from '../../components/Tracklist.astro';
import TrackLegend from '../../components/TrackLegend.astro';

const mdxComponents = {
  B, R, RB, U, URL, Band, Expand, LinkCard, Memo, Quote, Review,
  Spotify, SoundCloud, YouTube, Tabs, Tab, Tracklist, TrackLegend,
};

export async function getStaticPaths() {
  const stripThe = (s: string) => s.replace(/^The\s+/i, '');
  const articles = await getCollection('article');
  const works = await getCollection('work');
  const workMap = new Map(works.map(w => [w.id, w.data]));
  // ライブ棚から張られた記事 → 「棚に戻す」でそのライブの行へ戻す
  const lives = await getCollection('live');
  const liveBackMap = new Map(
    lives.filter(l => l.data.article).map(l => [l.data.article!.toLowerCase(), `/live#${l.id}`])
  );

  const workArticles = articles
    .filter(a => !!a.data.workId)
    .sort((a, b) => {
      const aw = workMap.get(a.data.workId!);
      const bw = workMap.get(b.data.workId!);
      const aKey = stripThe(aw?.artist || aw?.title || a.data.title);
      const bKey = stripThe(bw?.artist || bw?.title || b.data.title);
      const cmp = aKey.localeCompare(bKey, 'ja');
      if (cmp !== 0) return cmp;
      return (aw?.workYear ?? 0) - (bw?.workYear ?? 0);
    });

  return articles.map(article => {
    let prev: { href: string; title: string } | null = null;
    let next: { href: string; title: string } | null = null;
    if (article.data.workId) {
      const idx = workArticles.findIndex(a => a.id === article.id);
      if (idx > 0) {
        const p = workArticles[idx - 1];
        prev = { href: `/article/${p.id.split('/').pop()}`, title: p.data.title };
      }
      if (idx !== -1 && idx < workArticles.length - 1) {
        const n = workArticles[idx + 1];
        next = { href: `/article/${n.id.split('/').pop()}`, title: n.data.title };
      }
    }
    return {
      params: { slug: article.id.split('/').pop() },
      props: { article, prev, next, liveBackHref: liveBackMap.get(article.id.split('/').pop()!) ?? null },
    };
  });
}

const { article, prev, next, liveBackHref } = Astro.props;
const { Content } = await render(article);
const isWorkArticle = !!article.data.workId;
---

{isWorkArticle ? (
  <WorkLayout
    title={article.data.title}
    description={article.data.description}
    pubDate={article.data.pubDate}
    category={article.data.category}
    artwork={article.data.artwork}
    workId={article.data.workId}
    prev={prev}
    next={next}
    liveBackHref={liveBackHref}
  >
    <Content components={mdxComponents} />
  </WorkLayout>
) : (
  <ArticleLayout
    title={article.data.title}
    description={article.data.description}
    pubDate={article.data.pubDate}
    category={article.data.category}
    tags={article.data.tags}
    thumbnail={article.data.thumbnail ?? article.data.artwork}
    externalUrl={article.data.externalUrl}
    backHref={liveBackHref}
  >
    <Content components={mdxComponents} />
  </ArticleLayout>
)}
