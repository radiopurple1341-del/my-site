---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('article');
const pathTitleMap: Record<string, string> = {};
const likeIdLabelMap: Record<string, string> = {};
for (const article of articles) {
  const slug = article.id.split('/').pop()!;
  pathTitleMap[`/article/${slug}`] = article.data.title;
  if (article.id.startsWith('works/')) {
    likeIdLabelMap[`work:${slug}`] = article.data.title;
  }
}
const diaries = await getCollection('diary');
for (const diary of diaries) {
  likeIdLabelMap[`diary:${diary.id}`] = `日記 ${diary.id}`;
}
---

<BaseLayout title="Stats — without-sound.org">
  <div class="stats-page site-wrap">
    <h1 class="page-title">Stats</h1>
    <div id="stats-root">
      <p class="loading">読み込み中...</p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ pathTitleMap, likeIdLabelMap }}>
  function formatPath(path) {
    return pathTitleMap[path] || path;
  }

  function renderAllTimeTable(data) {
    if (!data.length) return '<p class="empty">データなし</p>';
    return `
      <table class="stats-table">
        <thead>
          <tr><th>#</th><th>ページ</th><th>PV</th></tr>
        </thead>
        <tbody>
          ${data.map((item, i) => `
            <tr>
              <td class="rank">${i + 1}</td>
              <td class="title"><a href="${item.path}">${formatPath(item.path)}</a></td>
              <td class="count">${item.total}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  function renderWeekTable({ dates, rows }) {
    if (!rows.length) return '<p class="empty">データなし</p>';
    const labels = dates.map(d => d.slice(5).replace('-', '/'));
    return `
      <div class="week-table-wrap">
        <table class="stats-table week-table">
          <thead>
            <tr>
              <th class="title-col">ページ</th>
              ${labels.map(l => `<th class="day-col">${l}</th>`).join('')}
              <th class="count">合計</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(row => `
              <tr>
                <td class="title"><a href="${row.path}">${formatPath(row.path)}</a></td>
                ${row.days.map(n => `<td class="day-val">${n || '-'}</td>`).join('')}
                <td class="count">${row.total}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  }

  function renderLikesTable(data) {
    if (!data.length) return '<p class="empty">データなし</p>';
    return `
      <table class="stats-table">
        <thead>
          <tr><th>#</th><th>記事 / 日記</th><th>★</th></tr>
        </thead>
        <tbody>
          ${data.map((item, i) => {
            const label = likeIdLabelMap[item.id] || item.id;
            const isWork = item.id.startsWith('work:');
            const slug = item.id.replace(/^work:/, '');
            const href = isWork ? `/article/${slug}` : '';
            const cell = href ? `<a href="${href}">${label}</a>` : label;
            return `
              <tr>
                <td class="rank">${i + 1}</td>
                <td class="title">${cell}</td>
                <td class="count">${item.count}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  async function loadStats() {
    try {
      const res = await fetch('/api/stats');
      const { allTime, last7days, likes } = await res.json();
      document.getElementById('stats-root').innerHTML = `
        <section>
          <h2 class="section-title">直近7日間</h2>
          ${renderWeekTable(last7days)}
        </section>
        <section>
          <h2 class="section-title">全期間</h2>
          ${renderAllTimeTable(allTime)}
        </section>
        <section>
          <h2 class="section-title">Favo ランキング</h2>
          ${renderLikesTable(likes)}
        </section>
      `;
    } catch {
      document.getElementById('stats-root').innerHTML = '<p class="empty">読み込みに失敗しました</p>';
    }
  }

  loadStats();
</script>

<style>
  .stats-page {
    padding: 40px 0 80px;
  }
  .page-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 40px;
    letter-spacing: -0.02em;
  }
  .section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 40px 0 12px;
  }
  .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .stats-table th {
    text-align: left;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .stats-table td {
    padding: 8px 12px 8px 0;
    border-bottom: 0.5px solid var(--color-border);
    vertical-align: middle;
  }
  .rank {
    width: 32px;
    color: var(--color-text-muted);
  }
  .title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .count {
    width: 60px;
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-accent);
  }
  .week-table-wrap {
    overflow-x: auto;
  }
  .week-table .title-col {
    min-width: 160px;
  }
  .day-col {
    width: 48px;
    text-align: right;
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .day-val {
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .loading, .empty {
    color: var(--color-text-muted);
    font-size: 13px;
  }
</style>
