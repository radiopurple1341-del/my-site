---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('article');
const works = await getCollection('work');
const pathTitleMap: Record<string, string> = {};
const likeIdLabelMap: Record<string, string> = {};
const workHasArticle: Record<string, boolean> = {};

for (const work of works) {
  likeIdLabelMap[`work:${work.id}`] = work.data.title;
}
for (const article of articles) {
  const slug = article.id.split('/').pop()!;
  pathTitleMap[`/article/${slug}`] = article.data.title;
  if (article.id.startsWith('works/')) {
    likeIdLabelMap[`work:${slug}`] = article.data.title;
    workHasArticle[slug] = true;
  }
}
const diaries = await getCollection('diary');
for (const diary of diaries) {
  likeIdLabelMap[`diary:${diary.id}`] = `日記 ${diary.id}`;
}
---

<BaseLayout title="Stats — without-sound.org">
  <div class="stats-page site-wrap">
    <h1 class="page-title">Stats</h1>
    <div id="stats-root">
      <p class="loading">読み込み中...</p>
    </div>
    <section>
      <h2 class="section-title">コメント一覧</h2>
      <div id="comments-root">
        <p class="loading">読み込み中...</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ pathTitleMap, likeIdLabelMap, workHasArticle }}>
  function formatPath(path) {
    return pathTitleMap[path] || path;
  }

  function renderAllTimeTable(data) {
    if (!data.length) return '<p class="empty">データなし</p>';
    return `
      <table class="stats-table">
        <thead>
          <tr><th>#</th><th>ページ</th><th>PV</th></tr>
        </thead>
        <tbody>
          ${data.map((item, i) => `
            <tr>
              <td class="rank">${i + 1}</td>
              <td class="title"><a href="${item.path}">${formatPath(item.path)}</a></td>
              <td class="count">${item.total}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  function renderWeekTable({ dates, rows }) {
    if (!rows.length) return '<p class="empty">データなし</p>';
    const labels = dates.map(d => d.slice(5).replace('-', '/'));
    return `
      <div class="week-table-wrap">
        <table class="stats-table week-table">
          <thead>
            <tr>
              <th class="title-col">ページ</th>
              ${labels.map(l => `<th class="day-col">${l}</th>`).join('')}
              <th class="count">合計</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(row => `
              <tr>
                <td class="title"><a href="${row.path}">${formatPath(row.path)}</a></td>
                ${row.days.map(n => `<td class="day-val">${n || '-'}</td>`).join('')}
                <td class="count">${row.total}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  }

  function renderLikesTable(data) {
    if (!data.length) return '<p class="empty">データなし</p>';
    return `
      <table class="stats-table">
        <thead>
          <tr><th>#</th><th>記事 / 日記</th><th>★</th></tr>
        </thead>
        <tbody>
          ${data.map((item, i) => {
            const label = likeIdLabelMap[item.id] || item.id;
            const isWork = item.id.startsWith('work:');
            const slug = item.id.replace(/^work:/, '');
            const href = isWork ? `/article/${slug}` : '';
            const cell = href ? `<a href="${href}">${label}</a>` : label;
            return `
              <tr>
                <td class="rank">${i + 1}</td>
                <td class="title">${cell}</td>
                <td class="count">${item.count}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  const PLATFORM_LABELS = { twitter: 'Twitter', line: 'LINE', bsky: 'Bluesky', hatena: 'はてブ', copy: 'コピー' };
  const PLATFORM_ORDER = ['twitter', 'line', 'bsky', 'hatena', 'copy'];

  function renderSharesTable(rows) {
    if (!rows.length) return '<p class="empty">データなし</p>';
    const byId = {};
    for (const row of rows) {
      if (!byId[row.id]) byId[row.id] = { total: 0, platforms: {} };
      byId[row.id].platforms[row.platform] = row.count;
      byId[row.id].total += row.count;
    }
    const sorted = Object.entries(byId).sort((a, b) => b[1].total - a[1].total).slice(0, 30);
    return `
      <table class="stats-table">
        <thead>
          <tr>
            <th>#</th><th>記事</th>
            ${PLATFORM_ORDER.map(p => `<th class="day-col">${PLATFORM_LABELS[p]}</th>`).join('')}
            <th>合計</th>
          </tr>
        </thead>
        <tbody>
          ${sorted.map(([id, data], i) => {
            const label = likeIdLabelMap[id] || id;
            const isWork = id.startsWith('work:');
            const slug = id.replace(/^work:/, '');
            const href = isWork ? `/article/${slug}` : '';
            const cell = href ? `<a href="${href}">${label}</a>` : label;
            return `
              <tr>
                <td class="rank">${i + 1}</td>
                <td class="title">${cell}</td>
                ${PLATFORM_ORDER.map(p => `<td class="day-val">${data.platforms[p] || '-'}</td>`).join('')}
                <td class="count">${data.total}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  function renderAffiliateClicksTable(rows) {
    if (!rows.length) return '<p class="empty">データなし</p>';
    return `
      <table class="stats-table">
        <thead>
          <tr><th>#</th><th>ファイル</th><th>URL</th><th>回数</th><th>最終クリック</th></tr>
        </thead>
        <tbody>
          ${rows.map((item, i) => {
            const label = likeIdLabelMap[item.source_id] || item.source_id;
            const isWork = item.source_id.startsWith('work:');
            const isDiary = item.source_id.startsWith('diary:');
            const slug = item.source_id.replace(/^work:|^diary:/, '');
            let href = '';
            if (isWork) href = workHasArticle[slug] ? `/article/${slug}` : `/works#${slug}`;
            if (isDiary) href = `/diary#${slug}`;
            const cell = href ? `<a href="${href}">${label}</a>` : label;
            return `
              <tr>
                <td class="rank">${i + 1}</td>
                <td class="title">${cell}</td>
                <td class="url"><a href="${item.url}" target="_blank" rel="noopener">${item.url}</a></td>
                <td class="count">${item.count}</td>
                <td class="date">${item.updated_at ?? '—'}</td>
              </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  function escHtml(str) {
    return String(str ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderCommentsTable(comments) {
    if (!comments.length) return '<p class="empty">コメントはありません</p>';
    return `
      <table class="stats-table comments-table">
        <thead>
          <tr>
            <th>日時</th>
            <th>記事</th>
            <th>投稿者</th>
            <th>内容</th>
          </tr>
        </thead>
        <tbody>
          ${comments.map(c => {
            const label = pathTitleMap[`/article/${c.article_id}`] || c.article_id;
            const idLabel = c.is_owner
              ? '<span class="comment-owner-badge">管理人</span>'
              : (c.poster_id ? `<span class="comment-id">ID:${c.poster_id}</span>` : '');
            return `
              <tr>
                <td class="date">${c.created_at}</td>
                <td class="title"><a href="/article/${c.article_id}">${escHtml(label)}</a></td>
                <td class="poster">${escHtml(c.name)} ${idLabel}${c.parent_id ? '<span class="reply-tag">返信</span>' : ''}</td>
                <td class="body">${escHtml(c.content)}</td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  async function loadComments() {
    try {
      const res = await fetch('/api/comment?all=1');
      const comments = await res.json();
      document.getElementById('comments-root').innerHTML = renderCommentsTable(comments);
    } catch {
      document.getElementById('comments-root').innerHTML = '<p class="empty">読み込みに失敗しました</p>';
    }
  }

  async function loadStats() {
    try {
      const res = await fetch('/api/stats');
      const { allTime, last7days, likes, shares, affiliateClicks } = await res.json();
      document.getElementById('stats-root').innerHTML = `
        <section>
          <h2 class="section-title">直近7日間</h2>
          ${renderWeekTable(last7days)}
        </section>
        <section>
          <h2 class="section-title">全期間</h2>
          ${renderAllTimeTable(allTime)}
        </section>
        <section>
          <h2 class="section-title">Favo ランキング</h2>
          ${renderLikesTable(likes)}
        </section>
        <section>
          <h2 class="section-title">シェア ランキング</h2>
          ${renderSharesTable(shares)}
        </section>
        <section>
          <h2 class="section-title">Amazonリンク クリック</h2>
          ${renderAffiliateClicksTable(affiliateClicks)}
        </section>
      `;
    } catch {
      document.getElementById('stats-root').innerHTML = '<p class="empty">読み込みに失敗しました</p>';
    }
  }

  loadStats();
  loadComments();
</script>

<style>
  .stats-page {
    padding: 40px 0 80px;
  }
  .page-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 40px;
    letter-spacing: -0.02em;
  }
  .section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 40px 0 12px;
  }
  .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .stats-table th {
    text-align: left;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .stats-table td {
    padding: 8px 12px 8px 0;
    border-bottom: 0.5px solid var(--color-border);
    vertical-align: middle;
  }
  .rank {
    width: 32px;
    color: var(--color-text-muted);
  }
  .title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .count {
    width: 60px;
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-accent);
  }
  .week-table-wrap {
    overflow-x: auto;
  }
  .week-table .title-col {
    min-width: 160px;
  }
  .day-col {
    width: 48px;
    text-align: right;
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .day-val {
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .loading, .empty {
    color: var(--color-text-muted);
    font-size: 13px;
  }
  .comments-table .date {
    white-space: nowrap;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
  .comments-table .title {
    max-width: 160px;
  }
  .comments-table .poster {
    white-space: nowrap;
  }
  .comments-table .body {
    max-width: 320px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .comment-id {
    font-size: 10px;
    color: var(--color-text-muted);
    font-family: monospace;
    margin-left: 4px;
  }
  .comment-owner-badge {
    font-size: 10px;
    color: var(--color-accent);
    border: 0.5px solid var(--color-accent);
    border-radius: 3px;
    padding: 0 4px;
    font-weight: 700;
    margin-left: 4px;
  }
  .reply-tag {
    font-size: 10px;
    color: var(--color-text-muted);
    margin-left: 4px;
  }
</style>
