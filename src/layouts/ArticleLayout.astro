---
import BaseLayout from './BaseLayout.astro';
import FavoShare from '../components/FavoShare.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  thumbnail?: string;
  externalUrl?: string;
  backHref?: string | null;  // 「棚に戻す」の戻り先（ライブ棚から張られた記事など）
}

const { title, description, pubDate, category, tags = [], thumbnail, externalUrl, backHref } = Astro.props;

// Favo・シェア集計のID（works記事の "work:{workId}" に対して main記事は "article:{slug}"）
const likeId = `article:${Astro.url.pathname.split('/').filter(Boolean).pop()}`;

const dateStr = `${String(pubDate.getFullYear()).slice(-2)}.${String(pubDate.getMonth() + 1).padStart(2, '0')}.${String(pubDate.getDate()).padStart(2, '0')}`;

const categoryClass: Record<string, string> = {
  '音楽': 'music', '映画': 'film', '漫画': 'manga', '書籍': 'novel', 'ゲーム': 'game', 'その他': 'other'
};
const catClass = categoryClass[category] ?? 'other';
---

<BaseLayout title={title} description={description} image={thumbnail}>
  <article class="article-wrap">
    <header class="article-header">
      <div class="article-meta">
        <span class={`tag ${catClass}`}>{category}</span>
        <time>{dateStr}</time>
      </div>
      <h1 class="article-title">{title}</h1>
      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    {thumbnail && (
      <div class="article-thumbnail">
        <img src={thumbnail} alt={title} onerror="this.src='/images/thumbnail-default.jpg'" />
      </div>
    )}

    {externalUrl ? (
      <div class="external-notice">
        <p class="external-intro">{description}</p>
        <a href={externalUrl} target="_blank" rel="noopener" class="external-link">
          元の記事を読む ↗
        </a>
      </div>
    ) : (
      <div class="article-body">
        <slot />
      </div>
    )}

    <FavoShare title={title} likeId={likeId} />

    {backHref && (
      <div class="article-footer">
        <a href={backHref} class="back-link">← 棚に戻す</a>
      </div>
    )}
  </article>
</BaseLayout>

<style>
.article-wrap { max-width: 680px; margin: 0 auto; }
.article-header { margin-bottom: 1.5rem; }
.article-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  font-size: 12px;
  color: var(--color-text-muted);
}
.article-title {
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 0.75rem;
}
.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.article-thumbnail {
  margin-bottom: 2rem;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 0.5px solid var(--color-border);
}
.article-thumbnail img { width: 100%; max-height: 360px; object-fit: cover; }
/* 本文・見出しサイズは WorkLayout の .work-body / Tabs の .tab-content と揃える */
.article-body {
  font-size: 17px;
  line-height: 1.85;
  color: var(--color-text);
}
@media (max-width: 800px) {
  .article-body { font-size: 16px; }
}
.article-body :global(h1) { font-size: 22px; margin: 0rem 0 1rem; font-weight: 700; }
.article-body :global(h2) { font-size: 20px; margin: 0rem 0 1rem; font-weight: 700; }
.article-body :global(h3) { font-size: 16px; margin: 1.5rem 0 0.75rem; font-weight: 700; }
.article-body :global(p) { margin-bottom: 1.25rem; }
.article-body :global(a) { color: var(--color-accent); text-decoration: underline; }
.article-body :global(blockquote) {
  border-left: 3px solid var(--color-border-mid);
  padding-left: 1rem;
  color: var(--color-text-mid);
  margin: 1.5rem 0;
}
/* 以下は WorkLayout の .work-body と同じ（work記事用コンポーネントをmain記事でも使うため） */
.article-body :global(ul), .article-body :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
}
.article-body :global(li) { margin-bottom: 0.3rem; overflow-wrap: anywhere; }
.article-body :global(li > ul), .article-body :global(li > ol) { margin: 0.3rem 0 0; }
.article-body :global(ul ul ul) { list-style-type: circle; }
.article-body :global(li:has(> .band)) { list-style: none; margin-left: -1.5rem; }
.article-body :global(li:has(> .band):not(:first-child)) { margin-top: 1.5rem; }
.article-body :global(li > .band) { margin: 0 0 0.5rem; }
.article-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin-bottom: 1.5rem;
}
.article-body :global(th) {
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
  text-transform: uppercase;
  padding: 0.3rem 0.75rem 0.3rem 0;
  border-bottom: 0.5px solid var(--color-border);
}
.article-body :global(td) {
  padding: 0.4rem 0.75rem 0.4rem 0;
  border-bottom: 0.5px solid var(--color-border);
  color: var(--color-text-mid);
}
.article-body :global(tr:last-child td) { border-bottom: none; }

.article-footer {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid var(--color-border);
}
/* WorkLayout の .back-link と同じ */
.back-link {
  display: inline-block;
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  background: #16263a;
  padding: 0.4rem 1rem;
  border-radius: 4px;
  text-decoration: none;
  transition: opacity 0.15s;
}
.back-link:hover { color: #fff; opacity: 0.85; text-decoration: none; }

.external-notice {
  background: var(--color-surface);
  border: 0.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}
.external-intro {
  font-size: 14px;
  color: var(--color-text-mid);
  line-height: 1.75;
  margin-bottom: 1rem;
}
.external-link {
  display: inline-block;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-accent);
  border: 0.5px solid var(--color-accent);
  border-radius: var(--radius-sm);
  padding: 0.4rem 0.875rem;
}
.external-link:hover {
  background: var(--color-accent);
  color: white;
  text-decoration: none;
}
</style>
