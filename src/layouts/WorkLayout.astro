---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL } from '../consts';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  category: string;
  artwork?: string;
  workId?: string | null;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
}

const { title, description, pubDate, category, artwork, workId, prev, next } = Astro.props;

const dateStr = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const categoryClass: Record<string, string> = {
  '音楽': 'music', '映画': 'film', '漫画': 'manga', '書籍': 'novel', 'ゲーム': 'game', 'その他': 'other'
};
const catClass = categoryClass[category] ?? 'other';

const backHref = workId ? `/works#${workId}` : '/works';
const rawPageUrl = `${SITE_URL}${Astro.url.pathname}`;
const pageUrl = encodeURIComponent(rawPageUrl);
const pageTitle = encodeURIComponent(`${title} | Without Sound`);
const twitterUrl = `https://twitter.com/intent/tweet?text=${pageTitle}&url=${pageUrl}`;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${pageUrl}`;
const bskyUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} | Without Sound ${rawPageUrl}`)}`;
const hatenaUrl = `https://b.hatena.ne.jp/entry/panel/?url=${pageUrl}&title=${pageTitle}`;
---

<BaseLayout title={title} description={description} image={artwork}>
  <article class="work-wrap">
    <header class="work-header">
      <div class="work-meta">
        <span class={`tag ${catClass}`}>{category}</span>
        <time>{dateStr}</time>
      </div>
      <h1 class="work-title">{title}</h1>
    </header>

    {artwork && (
      <div class="work-artwork">
        <img src={artwork} alt={title} />
      </div>
    )}

    <div class="work-body" data-work-id={workId}>
      <slot />
    </div>

    {workId && (
      <div class="favo-share-wrap">
        <div class="favo-section">
          <span class="favo-hint">この記事が気に入ったら：</span>
          <div class="favo-row" data-like-id={`work:${workId}`} role="button" tabindex="0" aria-label="いいね">
            <span class="star">☆</span><span class="like-count">0</span>
          </div>
        </div>
        <div class="favo-share-divider" />
        <div class="share-row" data-share-id={`work:${workId}`}>
          <span class="share-label">この記事をシェア</span>
          <a href={twitterUrl} target="_blank" rel="noopener" class="share-btn" data-platform="twitter">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="#1DA1F2"><path d="M23.954 4.569a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723 9.99 9.99 0 01-3.127 1.184 4.92 4.92 0 00-8.384 4.482C7.691 8.094 4.066 6.13 1.64 3.161a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.061a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.937 4.937 0 004.604 3.417 9.868 9.868 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.054 0 13.999-7.496 13.999-13.986 0-.209 0-.42-.015-.63a9.936 9.936 0 002.46-2.548l-.047-.02z"/></svg>Twitter
          </a>
          <a href={lineUrl} target="_blank" rel="noopener" class="share-btn" data-platform="line">
            <span class="brand-dot" style="background:#06C755"></span>LINE
          </a>
          <a href={bskyUrl} target="_blank" rel="noopener" class="share-btn" data-platform="bsky">
            <span class="brand-dot" style="background:#1185FE"></span>Bluesky
          </a>
          <a href={hatenaUrl} target="_blank" rel="noopener" class="share-btn" data-platform="hatena">
            <span class="brand-dot" style="background:#00A4DE"></span>はてブ
          </a>
          <button class="share-btn copy-btn" data-url={rawPageUrl} data-platform="copy">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            <span class="copy-label">URLコピー</span>
          </button>
        </div>
      </div>
    )}

    <div class="work-footer">
      <nav class="work-nav">
        <a href={backHref} class="back-link">← 作品棚に戻る</a>
      </nav>
    </div>

    {workId && (
      <section class="comment-section" data-article-id={workId}>
        <h2 class="comment-heading">コメント</h2>
        <div class="comment-list" id="comment-list">
          <p class="comment-empty">まだコメントはありません</p>
        </div>
        <div class="comment-form-wrap">
          <div class="reply-target" id="reply-target" style="display:none">
            <span id="reply-label"></span>
            <button class="reply-cancel" id="reply-cancel">✕</button>
          </div>
          <input class="comment-input" id="comment-name" type="text" placeholder="名前（省略可）" maxlength="50" />
          <textarea class="comment-input comment-textarea" id="comment-body" placeholder="コメントを書く（300文字以内）" maxlength="300" rows="3"></textarea>
          <div class="comment-form-footer">
            <span class="comment-count" id="comment-char">0 / 300</span>
            <button class="comment-submit" id="comment-submit">投稿</button>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
.work-wrap { max-width: 680px; margin: 0 auto; }

.work-header { margin-bottom: 1.5rem; }
.work-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  font-size: 12px;
  color: var(--color-text-muted);
}
.work-title {
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;
}

.work-artwork {
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 0.5px solid var(--color-border);
  max-width: 300px;
  margin-bottom: 2rem;
}
.work-artwork img { width: 100%; display: block; }

.favo-share-wrap {
  border: 0.5px solid #000;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);
  border-radius: var(--radius-md);
  background: #fff;
  overflow: hidden;
  margin-bottom: 1.5rem;
}
.favo-section {
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.favo-hint {
  font-size: 12px;
  color: var(--color-text-muted);
}
.favo-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 18px;
  border: 0.5px solid var(--color-border);
  border-radius: 999px;
  background: #fff;
  font-size: 15px;
  cursor: pointer;
  user-select: none;
  transition: color 0.15s, border-color 0.15s;
}
.favo-row:hover { border-color: var(--color-text-muted); color: var(--color-text); }
.favo-row.liked { color: #f5a623; }
.favo-row.liked .star { color: #f5a623; }
.star { display: inline-block; }
@keyframes star-pop {
  0%   { transform: translateY(0) scale(1); }
  35%  { transform: translateY(-6px) scale(1.45); }
  65%  { transform: translateY(-2px) scale(1.1); }
  100% { transform: translateY(0) scale(1); }
}
.star.popping { animation: star-pop 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
.favo-share-divider {
  height: 0.5px;
  background: var(--color-border);
  margin: 0 16px;
}
.share-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  padding: 10px 16px;
}
.share-label {
  font-size: 13px;
  color: var(--color-text-muted);
  white-space: nowrap;
  margin-right: 4px;
}
.share-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  border: 0.5px solid var(--color-border);
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 13px;
  color: var(--color-text-muted);
  text-decoration: none;
  background: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color 0.15s, border-color 0.15s;
}
.share-btn:hover { color: var(--color-text); border-color: var(--color-text-muted); }
.brand-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.like-btn {
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  padding: 0;
  color: var(--color-text-muted);
  font-size: 13px;
  line-height: 1;
  transition: color 0.15s;
}
.like-btn:hover { color: var(--color-text); }
.like-btn .star { font-size: 20px; }
.like-btn.liked .star { color: #f5a623; }
.like-btn.liked { color: #f5a623; }

.work-body {
  font-size: 15px;
  line-height: 1.85;
  color: var(--color-text);
}
.work-body :global(h2) { font-size: 18px; margin: 0rem 0 1rem; font-weight: 700; }
.work-body :global(h3) { font-size: 16px; margin: 1.5rem 0 0.75rem; font-weight: 700; }
.work-body :global(p) { margin-bottom: 1.25rem; }
.work-body :global(ul), .work-body :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
}
.work-body :global(li) { margin-bottom: 0.3rem; }
.work-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin-bottom: 1.5rem;
}
.work-body :global(th) {
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
  text-transform: uppercase;
  padding: 0.3rem 0.75rem 0.3rem 0;
  border-bottom: 0.5px solid var(--color-border);
}
.work-body :global(td) {
  padding: 0.4rem 0.75rem 0.4rem 0;
  border-bottom: 0.5px solid var(--color-border);
  color: var(--color-text-mid);
}
.work-body :global(tr:last-child td) { border-bottom: none; }

.work-footer {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid var(--color-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.work-nav {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}
.back-link {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text-muted);
}
.next-link {
  font-size: 12px;
  color: var(--color-text-muted);
}
.back-link:hover,
.next-link:hover { color: var(--color-text); text-decoration: none; }

/* コメント（静的要素） */
.comment-section {
  margin-top: 2.5rem;
  border-top: 0.5px solid var(--color-border);
  padding-top: 1.5rem;
}
.comment-heading {
  font-size: 11px;
  font-weight: 700;
  color: var(--color-text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 1.25rem;
}
.comment-list { margin-bottom: 1.75rem; }
.comment-form-wrap {
  background: var(--color-surface);
  border: 0.5px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 1rem;
}
.reply-target {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 12px;
  color: var(--color-text-muted);
  background: var(--color-bg);
  border: 0.5px solid var(--color-border);
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-sm);
  margin-bottom: 0.75rem;
}
.reply-cancel {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 11px;
  color: var(--color-text-muted);
  padding: 0;
  margin-left: auto;
}
.comment-input {
  width: 100%;
  box-sizing: border-box;
  border: 0.5px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.75rem;
  font-size: 13px;
  background: var(--color-bg);
  color: var(--color-text);
  margin-bottom: 0.5rem;
  font-family: inherit;
}
.comment-input:focus { outline: none; border-color: var(--color-text-muted); }
.comment-textarea { resize: vertical; min-height: 72px; }
.comment-form-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.comment-count { font-size: 11px; color: var(--color-text-muted); }
.comment-submit {
  font-size: 12px;
  padding: 0.35rem 1.1rem;
  border: 0.5px solid var(--color-border);
  border-radius: 999px;
  background: var(--color-bg);
  cursor: pointer;
  color: var(--color-text);
  transition: background 0.15s;
}
.comment-submit:hover { background: var(--color-border); }
.comment-submit:disabled { opacity: 0.4; cursor: default; }

/* コメント（JS動的生成要素 → :global必須） */
:global(.comment-empty) { font-size: 13px; color: var(--color-text-muted); }
:global(.comment-item) {
  padding: 0.9rem 0;
  border-bottom: 0.5px solid var(--color-border);
}
:global(.comment-item:last-child) { border-bottom: none; }
:global(.comment-item.is-reply) {
  margin-left: 1.25rem;
  padding-left: 1rem;
  border-left: 2px solid var(--color-border);
  border-bottom: none;
  padding-bottom: 0.25rem;
}
:global(.comment-meta) {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 0.35rem;
}
:global(.comment-name) { font-size: 13px; font-weight: 700; color: var(--color-text); }
:global(.comment-date) { font-size: 11px; color: var(--color-text-muted); }
:global(.comment-body) { font-size: 13px; color: var(--color-text-mid); line-height: 1.75; white-space: pre-wrap; margin: 0; }
:global(.comment-reply-btn) {
  font-size: 11px;
  color: var(--color-text-muted);
  background: none;
  border: 0.5px solid var(--color-border);
  border-radius: 999px;
  cursor: pointer;
  padding: 0.15rem 0.65rem;
  margin-top: 0.4rem;
  transition: color 0.15s, border-color 0.15s;
}
:global(.comment-reply-btn:hover) { color: var(--color-text); border-color: var(--color-text-muted); }
:global(.comment-id) { font-size: 10px; color: var(--color-text-muted); font-family: monospace; }
:global(.comment-owner-badge) {
  font-size: 10px;
  color: var(--color-accent);
  border: 0.5px solid var(--color-accent);
  border-radius: 3px;
  padding: 0 4px;
  font-weight: 700;
}
:global(.comment-item.is-owner > .comment-meta > .comment-name) { color: var(--color-accent); }
</style>

<script>
  const favoRow = document.querySelector<HTMLElement>('.favo-row[data-like-id]');
  if (favoRow) {
    const id = favoRow.dataset.likeId!;
    const starEl = favoRow.querySelector<HTMLElement>('.star')!;

    if (localStorage.getItem('liked_' + id)) {
      starEl.textContent = '★';
      favoRow.classList.add('liked');
    }

    fetch(`/api/like?ids=${id}`)
      .then(r => r.json())
      .then((counts: Record<string, number>) => {
        favoRow.querySelector('.like-count')!.textContent = String(counts[id] ?? 0);
      })
      .catch(() => {});

    const toggle = async () => {
      const isLiked = !!localStorage.getItem('liked_' + id);
      if (isLiked) {
        localStorage.removeItem('liked_' + id);
        starEl.textContent = '☆';
        favoRow.classList.remove('liked');
      } else {
        localStorage.setItem('liked_' + id, '1');
        starEl.textContent = '★';
        favoRow.classList.add('liked');
        starEl.classList.remove('popping');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          starEl.classList.add('popping');
          starEl.addEventListener('animationend', () => starEl.classList.remove('popping'), { once: true });
        }));
      }
      try {
        const res = await fetch('/api/like', {
          method: isLiked ? 'DELETE' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const { count } = await res.json();
        favoRow.querySelector('.like-count')!.textContent = String(count);
      } catch {}
    };

    favoRow.addEventListener('click', toggle);
    favoRow.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') toggle(); });
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('.copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.url!;
      const label = copyBtn.querySelector('.copy-label')!;
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = 'コピーしました';
        setTimeout(() => { label.textContent = 'URLコピー'; }, 1500);
      } catch {}
    });
  }

  const shareRow = document.querySelector<HTMLElement>('.share-row[data-share-id]');
  if (shareRow) {
    const shareId = shareRow.dataset.shareId!;
    shareRow.querySelectorAll<HTMLElement>('[data-platform]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const platform = btn.dataset.platform!;
        fetch('/api/share', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: shareId, platform }),
        }).catch(() => {});
      });
    });
  }

  // Amazonアフィリエイトリンクのクリック集計
  const workBody = document.querySelector<HTMLElement>('.work-body[data-work-id]');
  if (workBody) {
    const workId = workBody.dataset.workId!;
    workBody.querySelectorAll<HTMLAnchorElement>('a[href^="https://amzn.to/"]').forEach((a) => {
      a.addEventListener('click', () => {
        fetch('/api/affiliate-click', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ source_id: `work:${workId}`, url: a.href }),
          keepalive: true,
        }).catch(() => {});
      });
    });
  }

  // コメント
  const commentSection = document.querySelector<HTMLElement>('.comment-section');
  if (commentSection) {
    const articleId = commentSection.dataset.articleId!;
    const listEl = document.getElementById('comment-list')!;
    const nameEl = document.getElementById('comment-name') as HTMLInputElement;
    const bodyEl = document.getElementById('comment-body') as HTMLTextAreaElement;
    const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement;
    const charEl = document.getElementById('comment-char')!;
    const replyTarget = document.getElementById('reply-target')!;
    const replyLabel = document.getElementById('reply-label')!;
    const replyCancel = document.getElementById('reply-cancel')!;
    let replyToId: number | null = null;
    let replyToName = '';

    // URLパラメータでadminトークンをlocalStorageに保存
    const urlParams = new URLSearchParams(location.search);
    const adminParam = urlParams.get('admin');
    if (adminParam) {
      localStorage.setItem('admin_token', adminParam);
      history.replaceState({}, '', location.pathname);
    }
    const adminToken = localStorage.getItem('admin_token');

    type Comment = { id: number; parent_id: number | null; name: string; content: string; created_at: string; poster_id?: string; is_owner?: number };

    function renderComments(comments: Comment[]) {
      const parents = comments.filter(c => !c.parent_id);
      const childMap = new Map<number, Comment[]>();
      comments.filter(c => c.parent_id).forEach(c => {
        const arr = childMap.get(c.parent_id!) ?? [];
        arr.push(c);
        childMap.set(c.parent_id!, arr);
      });

      if (!parents.length) {
        listEl.innerHTML = '<p class="comment-empty">まだコメントはありません</p>';
        return;
      }

      listEl.innerHTML = parents.map(p => {
        const replies = (childMap.get(p.id) ?? []).map(r => commentHTML(r, true)).join('');
        return commentHTML(p, false) + replies;
      }).join('');

      listEl.querySelectorAll<HTMLButtonElement>('.comment-reply-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          replyToId = Number(btn.dataset.id);
          replyToName = btn.dataset.name!;
          replyLabel.textContent = `▶ ${replyToName} さんへの返信`;
          replyTarget.style.display = 'flex';
          bodyEl.focus();
        });
      });
    }

    function commentHTML(c: Comment, isReply: boolean) {
      const isOwner = !!c.is_owner;
      const idLabel = c.poster_id
        ? (isOwner
          ? `<span class="comment-owner-badge">管理人</span>`
          : `<span class="comment-id">ID:${c.poster_id}</span>`)
        : '';
      return `<div class="comment-item${isReply ? ' is-reply' : ''}${isOwner ? ' is-owner' : ''}">
        <div class="comment-meta">
          <span class="comment-name">${escHtml(c.name)}</span>
          <span class="comment-date">${c.created_at}</span>
          ${idLabel}
        </div>
        <p class="comment-body">${escHtml(c.content)}</p>
        ${!isReply ? `<button class="comment-reply-btn" data-id="${c.id}" data-name="${escHtml(c.name)}">返信</button>` : ''}
      </div>`;
    }

    function escHtml(s: string) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    fetch(`/api/comment?article_id=${articleId}`)
      .then(r => r.json())
      .then((data: Comment[]) => renderComments(data))
      .catch(() => {});

    bodyEl.addEventListener('input', () => {
      charEl.textContent = `${bodyEl.value.length} / 300`;
    });

    replyCancel.addEventListener('click', () => {
      replyToId = null;
      replyToName = '';
      replyTarget.style.display = 'none';
    });

    submitBtn.addEventListener('click', async () => {
      const content = bodyEl.value.trim();
      if (!content) return;
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/comment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ article_id: articleId, parent_id: replyToId, name: nameEl.value, content, admin_token: adminToken }),
        });
        if (!res.ok) throw new Error();
        bodyEl.value = '';
        charEl.textContent = '0 / 300';
        replyToId = null;
        replyTarget.style.display = 'none';
        const data: Comment[] = await fetch(`/api/comment?article_id=${articleId}`).then(r => r.json());
        renderComments(data);
      } catch {
        alert('投稿に失敗しました。');
      } finally {
        setTimeout(() => { submitBtn.disabled = false; }, 2000);
      }
    });
  }
</script>
